# Direct storage: publish verified HTTPS on fixed public 443.
TLS_ENABLED=true
SERVER_NAME=storage.4399.com
STORAGE_ENDPOINT=https://storage.4399.com
# STORAGE_TRANSPORT=direct
# STORAGE_PORT=443
# DATA_DIRECTORY=./storage-data
# Relay uses a restricted high port, never public HTTP/HTTPS 80/443:
# STORAGE_TRANSPORT=relay
# STORAGE_PORT=8443
# STORAGE_ENDPOINT=https://storage.4399.com:8443
