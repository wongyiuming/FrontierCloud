ENVIRONMENT=production
# Collection agents/exporters run in every environment. This profile additionally
# enables the production-style MySQL backup worker; use it in test and production.
COMPOSE_PROFILES=monitoring
REDIS_URL=redis://redis:6379/0
# Generate before deployment: openssl rand -hex 32
ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Generate both database passwords independently. URL-encode MYSQL_PASSWORD in MYSQL_URL.
MYSQL_URL=mysql+asyncmy://media_admin:REPLACE_WITH_URL_ENCODED_PASSWORD@mysql:3306/office_automation

# Issue one independent token every 15 minutes. New pending tokens have a
# five-second handover overlap; once used, each token owns a separate 15-minute
# sliding TTL, so actively used older tokens survive.
ADMIN_TOKEN_TTL=900
ADMIN_TOKEN_ISSUE_INTERVAL=900
ADMIN_SESSION_TTL=900
ADMIN_MAX_FAILED_ATTEMPTS_PER_IP=10
ADMIN_FAILED_WINDOW=300
# Exact per-file limit: 800 MiB. Nginx allows 820 MiB for multipart overhead.
ADMIN_MAX_UPLOAD_FILE_SIZE=838860800
# One upload task is sent as independent one-file requests.
ADMIN_MAX_UPLOAD_TASK_FILES=5000
# Maximum objects accepted by one delete/hide management request.
ADMIN_MAX_BATCH_FILES=200
ADMIN_MAX_DOWNLOAD_ITEMS=100
ADMIN_MAX_FILENAME_LENGTH=240
MEDIA_MAX_DEPTH=32
# Admin mutations invalidate immediately; this TTL covers out-of-band filesystem changes.
MEDIA_CATALOG_CACHE_TTL=300

# Client-side WebRTC address observation through the deployment's bounded,
# STUN-only coturn service. Keep host/port deployment-specific and outside code.
WEBRTC_STUN_HOST=example.com
WEBRTC_STUN_PORT=3478
WEBRTC_STUN_URLS=stun:${WEBRTC_STUN_HOST}:${WEBRTC_STUN_PORT}
WEBRTC_REPORT_COOLDOWN=60

# Generate before deployment: openssl rand -hex 32. Nginx injects this header
# only for the allowlisted monitoring endpoint; it is never sent by browsers.
INTERNAL_METRICS_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
# CIDR or single-host /32 for the current monitoring environment. Never place a
# deployment IP in Compose or Nginx source files.
MONITORING_ALLOW_CIDR=192.0.2.1/32
METRICS_BASIC_USER=frontiercloud_monitor
METRICS_BASIC_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
MYSQL_EXPORTER_USER=frontiercloud_exporter
MYSQL_EXPORTER_PASSWORD=REPLACE_WITH_DIFFERENT_OPENSSL_RAND_HEX_32
MYSQL_BACKUP_USER=frontiercloud_backup
MYSQL_BACKUP_PASSWORD=REPLACE_WITH_THIRD_OPENSSL_RAND_HEX_32
# Host directory for seven days of daily MySQL backups.
BACKUP_DIR=./backups
# Copy-truncate the Nginx metrics log after it reaches this many bytes.
NGINX_METRIC_LOG_MAX_BYTES=10485760

# Public watermark endpoint resource limits. Keep the per-request total below
# available container memory; archive limits apply to decompressed content.
WATERMARK_MAX_FILES=20
WATERMARK_MAX_UPLOAD_FILE_SIZE=67108864
WATERMARK_MAX_UPLOAD_TOTAL_SIZE=67108864
WATERMARK_MAX_ARCHIVE_FILES=200
WATERMARK_MAX_ARCHIVE_FILE_SIZE=67108864
WATERMARK_MAX_ARCHIVE_TOTAL_SIZE=134217728
WATERMARK_MAX_IMAGE_PIXELS=8000000
WATERMARK_MAX_PDF_PAGES=200
WATERMARK_MAX_TEXT_LENGTH=200
WATERMARK_MAX_CONCURRENT_JOBS=1
WATERMARK_MAX_WORKERS=2

# Only the Docker Nginx network may supply X-Real-IP. Loopback is never auto-banned.
TRUSTED_PROXY_NETWORKS=172.16.0.0/12
SECURITY_EXEMPT_NETWORKS=127.0.0.0/8,::1/128
# The sixth unmatched/invalid-method request inside one sliding hour triggers a 24-hour ban.
SECURITY_INVALID_API_LIMIT=5
SECURITY_INVALID_API_WINDOW=3600
SECURITY_AUTO_BAN_TTL=86400
SECURITY_RECENT_BAN_HOURS=24

# Production: true. Local HTTP-only development: false.
ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_SAMESITE=strict
ADMIN_COOKIE_NAME=__Host-admin_session
ADMIN_CSRF_COOKIE_NAME=__Host-admin_csrf

MYSQL_DATABASE=office_automation
MYSQL_USER=media_admin
MYSQL_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_ROOT_PASSWORD

SERVER_NAME=example.com
HTTP_PORT=80
HTTPS_PORT=443
SSL_CERT_PATH=./certs/fullchain.pem
SSL_KEY_PATH=./certs/privkey.pem
# The public Nginx container serves certificate renewal challenges from this directory.
ACME_WEBROOT=./certs/acme
