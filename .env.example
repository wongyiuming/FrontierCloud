# Optional: Enables built-in HTTPS; SERVER_NAME becomes required when enabled.
# TLS_ENABLED=false
# Optional, but required for HTTPS: Public hostname and the host used to derive the STUN URL.
# SERVER_NAME=example.com
# Optional: Plain instance identity included in logs and metrics without changing behavior.
# INSTANCE_NAME=frontiercloud
# Optional: Minimum application log level.
# LOG_LEVEL=INFO
# Optional: stdout/stderr log format, either json or text.
# LOG_FORMAT=json
# Optional: Bearer token for /metrics; an empty value keeps the endpoint hidden.
# METRICS_TOKEN=
# Optional: Redis connection URL.
# REDIS_URL=redis://redis:6379/0
# Optional: Database name created in the bundled MySQL service.
# MYSQL_DATABASE=office_automation
# Optional: Application user created in the bundled MySQL service.
# MYSQL_USER=media_admin
# Optional: Idle lifetime in seconds for an Admin WebUI session; this does not affect the Admin Key lifecycle.
# ADMIN_SESSION_TTL=900
# Optional: Failed Admin Key attempts allowed per IP within the login failure window.
# ADMIN_MAX_FAILED_ATTEMPTS_PER_IP=10
# Optional: Admin Key login failure counting window in seconds.
# ADMIN_FAILED_WINDOW=300
# Optional: Maximum size in bytes of one uploaded file.
# ADMIN_MAX_UPLOAD_FILE_SIZE=838860800
# Optional: Upload connection inactivity timeout in seconds.
# ADMIN_UPLOAD_INACTIVITY_TIMEOUT=300
# Optional: Maximum file count in one upload task.
# ADMIN_MAX_UPLOAD_TASK_FILES=5000
# Optional: Maximum object count accepted by one batch hide or delete request.
# ADMIN_MAX_BATCH_FILES=200
# Optional: Maximum object count accepted by one download request.
# ADMIN_MAX_DOWNLOAD_ITEMS=100
# Optional: SameSite policy for Admin cookies, either strict or lax.
# ADMIN_COOKIE_SAMESITE=strict
# Optional: Maximum character count accepted in an uploaded filename.
# ADMIN_MAX_FILENAME_LENGTH=240
# Optional: Maximum supported media directory depth.
# MEDIA_MAX_DEPTH=32
# Optional: Media catalog cache lifetime in seconds.
# MEDIA_CATALOG_CACHE_TTL=300
# Optional: Listening and published port for the mandatory bundled STUN service.
# WEBRTC_STUN_PORT=3478
# Optional: WebRTC probe period in seconds, starting with the initial browser connection.
# WEBRTC_REPORT_COOLDOWN=30
# Optional: Reverse proxy networks allowed to supply the verified client address header.
# TRUSTED_PROXY_NETWORKS=172.16.0.0/12
# Optional: Infrastructure networks excluded from automatic IP blocking.
# SECURITY_EXEMPT_NETWORKS=127.0.0.0/8,::1/128
# Optional: Invalid API requests allowed within the window before automatic blocking.
# SECURITY_INVALID_API_LIMIT=5
# Optional: Sliding window in seconds for invalid API request counting.
# SECURITY_INVALID_API_WINDOW=3600
# Optional: Recent ban history period in hours shown by default in Admin WebUI.
# SECURITY_RECENT_BAN_HOURS=24
# Optional: Host port that publishes HTTP.
# HTTP_PORT=80
# Optional: Host port that publishes HTTPS.
# HTTPS_PORT=443
# Optional: Path to the HTTPS certificate chain.
# SSL_CERT_PATH=./certs/fullchain.pem
# Optional: Path to the HTTPS private key.
# SSL_KEY_PATH=./certs/privkey.pem
# Optional: Read-only directory serving ACME HTTP-01 challenge files.
# ACME_WEBROOT=./certs/acme
