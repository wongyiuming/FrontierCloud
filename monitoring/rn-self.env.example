# Required RN self-monitoring values
PRODUCTION_METRICS_HOST=preproduction.example.com
MONITORED_ENVIRONMENT=preproduction
MONITORING_ROLE=rn-self-observer
TARGET_JOB_PREFIX=preproduction
METRICS_BASIC_PASSWORD=REPLACE_WITH_RN_METRICS_PASSWORD
TG_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TG_CHAT_ID=REPLACE_WITH_NUMERIC_CHAT_ID
MONITORING_SERVER_NAME=preproduction.example.com
MONITORING_TLS_CERT_PATH=/etc/letsencrypt/live/preproduction.example.com/fullchain.pem
MONITORING_TLS_KEY_PATH=/etc/letsencrypt/live/preproduction.example.com/privkey.pem
MONITORING_BASIC_PASSWORD=REPLACE_WITH_INDEPENDENT_OPENSSL_RAND_BASE64_36
# Generate with: docker run --rm -it --entrypoint htpasswd httpd:2.4-alpine -nBC 12 USER
MONITORING_BASIC_PASSWORD_HASH='REPLACE_WITH_INDEPENDENT_BCRYPT_HASH'
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_INDEPENDENT_OPENSSL_RAND_HEX_32

# This instance owns independent runtime files, ports, containers, networks,
# and volumes. Do not reuse the production-observer runtime directory.
MONITORING_RUNTIME_DIR=./instances/rn-self
MONITORING_EXTRA_CONFIG_DIR=./instances/rn-self/server.d
MONITORING_HTTP_PORT=9080
MONITORING_HTTPS_PORT=9443
PROMETHEUS_RETENTION_TIME=8d
PROMETHEUS_RETENTION_SIZE=1GB
PROMETHEUS_MEMORY_LIMIT=256m
GRAFANA_MEMORY_LIMIT=192m

# Optional overrides
# METRICS_BASIC_USER=frontiercloud_monitor
# MONITORING_BASIC_USER=frontier_observer
# GRAFANA_ADMIN_USER=frontier_admin
# MONITORING_ACME_WEBROOT=/var/www/certbot
