{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {"type":"stat","title":"Targets Up","gridPos":{"h":4,"w":6,"x":0,"y":0},"targets":[{"expr":"sum(up)","refId":"A"}]},
    {"type":"stat","title":"Health Probe","gridPos":{"h":4,"w":6,"x":6,"y":0},"targets":[{"expr":"probe_success{job=\"blackbox-health\"}","refId":"A"}]},
    {"type":"gauge","title":"Host CPU %","gridPos":{"h":4,"w":6,"x":12,"y":0},"fieldConfig":{"defaults":{"min":0,"max":100,"unit":"percent"}},"targets":[{"expr":"100-(avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))*100)","refId":"A"}]},
    {"type":"gauge","title":"Host Memory %","gridPos":{"h":4,"w":6,"x":18,"y":0},"fieldConfig":{"defaults":{"min":0,"max":100,"unit":"percent"}},"targets":[{"expr":"(1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes)*100","refId":"A"}]},
    {"type":"timeseries","title":"HTTP Request Rate","gridPos":{"h":7,"w":12,"x":0,"y":4},"targets":[{"expr":"sum by(status) (rate(frontiercloud_http_requests_total[5m]))","legendFormat":"{{status}}","refId":"A"}]},
    {"type":"timeseries","title":"HTTP P95 Latency","gridPos":{"h":7,"w":12,"x":12,"y":4},"fieldConfig":{"defaults":{"unit":"s"}},"targets":[{"expr":"histogram_quantile(0.95,sum by(le)(rate(frontiercloud_http_request_duration_seconds_bucket[5m])))","refId":"A"}]},
    {"type":"timeseries","title":"Network Throughput","gridPos":{"h":7,"w":12,"x":0,"y":11},"fieldConfig":{"defaults":{"unit":"Bps"}},"targets":[{"expr":"sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[5m]))","legendFormat":"receive","refId":"A"},{"expr":"sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[5m]))","legendFormat":"transmit","refId":"B"}]},
    {"type":"timeseries","title":"Container Memory","gridPos":{"h":7,"w":12,"x":12,"y":11},"fieldConfig":{"defaults":{"unit":"bytes"}},"targets":[{"expr":"container_memory_working_set_bytes{name=~\"office_automation_.*|frontiercloud_.*\"}","legendFormat":"{{name}}","refId":"A"}]},
    {"type":"stat","title":"Redis Up","gridPos":{"h":4,"w":6,"x":0,"y":18},"targets":[{"expr":"redis_up","refId":"A"}]},
    {"type":"stat","title":"MySQL Up","gridPos":{"h":4,"w":6,"x":6,"y":18},"targets":[{"expr":"mysql_up","refId":"A"}]},
    {"type":"timeseries","title":"Nginx Connections","gridPos":{"h":4,"w":6,"x":12,"y":18},"targets":[{"expr":"nginx_connections_active","refId":"A"}]},
    {"type":"timeseries","title":"Disk Available %","gridPos":{"h":4,"w":6,"x":18,"y":18},"fieldConfig":{"defaults":{"unit":"percent"}},"targets":[{"expr":"node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|nsfs\"}/node_filesystem_size_bytes*100","legendFormat":"{{mountpoint}}","refId":"A"}]}
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": ["frontiercloud", "production"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "FrontierCloud Overview",
  "uid": "frontiercloud-overview",
  "version": 1
