# Required deployment values
PRODUCTION_METRICS_HOST=example.com
MONITORED_ENVIRONMENT=production
MONITORING_ROLE=production-observer
TARGET_JOB_PREFIX=production
METRICS_BASIC_PASSWORD=REPLACE_WITH_PRODUCTION_METRICS_PASSWORD
TG_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TG_CHAT_ID=REPLACE_WITH_NUMERIC_CHAT_ID
MONITORING_SERVER_NAME=monitoring.example.com
MONITORING_TLS_CERT_PATH=/etc/letsencrypt/live/monitoring.example.com/fullchain.pem
MONITORING_TLS_KEY_PATH=/etc/letsencrypt/live/monitoring.example.com/privkey.pem
MONITORING_BASIC_PASSWORD=REPLACE_WITH_OPENSSL_RAND_BASE64_36
# Generate with: docker run --rm -it --entrypoint htpasswd httpd:2.4-alpine -nBC 12 USER
# Keep the bcrypt value single-quoted so Compose treats dollar signs literally.
MONITORING_BASIC_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32

# RN-only weekly reporter. DB-IP City Lite is downloaded to RN monthly and read
# locally; client addresses are never sent to a third-party geolocation API.
REPORT_PRODUCTION_SECURITY_URL=https://example.com/internal/report/security
REPORT_PRODUCTION_ACCESS_LOG_URL=https://example.com/internal/report/access-log
REPORT_PREPRODUCTION_PROMETHEUS_URL=https://preproduction.example.com:9443/prometheus
REPORT_PREPRODUCTION_SECURITY_URL=https://preproduction.example.com/internal/report/security
REPORT_PREPRODUCTION_ACCESS_LOG_URL=https://preproduction.example.com/internal/report/access-log

# Optional overrides
# Add only the settings that this deployment needs to change. The monitoring
# renderer and Compose file own the defaults shown below.
# METRICS_BASIC_USER=frontiercloud_monitor
# MONITORING_HTTP_PORT=8080
# MONITORING_HTTPS_PORT=8443
# MONITORING_ACME_WEBROOT=/var/www/certbot
# MONITORING_BASIC_USER=frontier_observer
# GRAFANA_ADMIN_USER=frontier_admin
# MONITORING_RUNTIME_DIR=.
# MONITORING_EXTRA_CONFIG_DIR=./nginx/server.d
# PROMETHEUS_RETENTION_TIME=8d
# PROMETHEUS_RETENTION_SIZE=3GB
# PROMETHEUS_MEMORY_LIMIT=768m
# GRAFANA_MEMORY_LIMIT=384m
# REPORT_TIMEZONE=Asia/Shanghai
# REPORT_SELF_RUNTIME_DIR=./instances/rn-self
# GITHUB_REPOSITORY=wongyiuming/FrontierCloud
