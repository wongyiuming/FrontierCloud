global:
  resolve_timeout: 5m

route:
  receiver: telegram
  group_by: [alertname, service, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

inhibit_rules:
  - source_matchers: [severity="critical"]
    target_matchers: [severity="warning"]
    equal: [alertname, instance]

receivers:
  - name: telegram
    telegram_configs:
      - bot_token_file: /run/secrets/tg_bot_token
        chat_id: __TG_CHAT_ID__
        send_resolved: true
        parse_mode: HTML
        message: |-
          {{ if eq .Status "firing" }}🔥 FIRING{{ else }}✅ RESOLVED{{ end }} · FrontierCloud
          {{ range .Alerts }}
          <b>{{ .Labels.alertname }}</b> [{{ .Labels.severity }}]
          服务: {{ .Labels.service }}
          实例: {{ .Labels.instance }}
          {{ .Annotations.summary }}
          {{ .Annotations.description }}
          开始: {{ .StartsAt }}{{ if eq $.Status "resolved" }}
          恢复: {{ .EndsAt }}{{ end }}
          {{ end }}
