{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Release Manifest v1","type":"object","additionalProperties":false,"required":["format","version","release_version","protocol","schema_generation","artifacts"],"properties":{"format":{"const":"frontiercloud-release-manifest"},"version":{"const":1},"release_version":{"type":"string","pattern":"^[0-9][a-zA-Z0-9._-]{0,63}$"},"protocol":{"const":2},"schema_generation":{"const":2},"artifacts":{"type":"object","additionalProperties":false,"required":["main","gin_main"],"properties":{"main":{"$ref":"#/$defs/artifact"},"gin_main":{"$ref":"#/$defs/artifact"}}}},"$defs":{"artifact":{"type":"object","additionalProperties":false,"required":["kind","commit_sha","source_sha","tree_sha"],"properties":{"kind":{"const":"git-archive"},"commit_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"source_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"tree_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"}}}}}
