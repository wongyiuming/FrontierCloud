{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontiercloud.local/protocol/v2/schemas/identity.json",
  "title": "FrontierCloud Protocol v2 identity envelope",
  "type": "object",
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "required": ["node_id", "role", "endpoint", "public_key", "challenge", "protocol", "app_version"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "role": {"enum": ["Standalone", "Master", "Follower"]},
        "endpoint": {"type": "string"},
        "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "challenge": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "protocol": {"const": 2},
        "app_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "additionalProperties": false
}

